#!/usr/bin/env python3
"""Prove the agent guard blocks what it must and allows what it must.

Reads the pattern straight out of .claude/hookify.branch-name-guard.local.md,
so the rule that is tested is the rule that is installed, and runs every case
in tests/branch-guard-cases.tsv against it. A case is a command an agent might
send; the guard blocks a command when the pattern matches anywhere in it.

Usage: scripts/check-branch-guard     exit 0 when every case holds
"""
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
RULE = ROOT / ".claude" / "hookify.branch-name-guard.local.md"
CASES = ROOT / "tests" / "branch-guard-cases.tsv"


def pattern_from_rule(text):
    front = text.split("---")[1]
    found = re.findall(r"^\s*pattern:\s*'(.*)'\s*$", front, re.M)
    if len(found) != 1:
        sys.exit(f"check-branch-guard: expected one single-quoted pattern in {RULE}, found {len(found)}")
    return re.compile(found[0].replace("''", "'"))


def main():
    pat = pattern_from_rule(RULE.read_text(encoding="utf-8"))
    failed = 0
    count = 0
    for n, line in enumerate(CASES.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip() or line.startswith("#"):
            continue
        want, _, cmd = line.partition("\t")
        if want not in ("block", "allow") or not cmd:
            sys.exit(f"check-branch-guard: {CASES}:{n} is not 'block|allow<TAB>command'")
        count += 1
        got = "block" if pat.search(cmd) else "allow"
        if got != want:
            failed += 1
            print(f"FAIL  line {n}: wanted {want}, got {got}: {cmd}")
    if count == 0:
        sys.exit("check-branch-guard: no cases found")
    if failed:
        print(f"check-branch-guard: {failed} of {count} cases failed")
        return 1
    print(f"check-branch-guard: {count} of {count} cases hold")
    return 0


if __name__ == "__main__":
    sys.exit(main())
